<Page x:Class="LaptopShop.WPF.Frames.AdminHomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="1200"
      Title="AdminHomePage">

    <Grid Background="White" Margin="10">
        <TabControl>
            <TabItem Header="Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="Admin Dashboard" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                        <WrapPanel Margin="0,0,0,20">
                            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="5" Width="180">
                                <StackPanel>
                                    <TextBlock Text="Total Users" FontWeight="Bold"/>
                                    <TextBlock x:Name="txtTotalUsers" FontSize="20"/>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="5" Width="180">
                                <StackPanel>
                                    <TextBlock Text="Active Users" FontWeight="Bold"/>
                                    <TextBlock x:Name="txtActiveUsers" FontSize="20"/>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="5" Width="180">
                                <StackPanel>
                                    <TextBlock Text="Total Products" FontWeight="Bold"/>
                                    <TextBlock x:Name="txtTotalProducts" FontSize="20"/>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="5" Width="180">
                                <StackPanel>
                                    <TextBlock Text="Active Products" FontWeight="Bold"/>
                                    <TextBlock x:Name="txtActiveProducts" FontSize="20"/>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="5" Width="180">
                                <StackPanel>
                                    <TextBlock Text="Total Orders" FontWeight="Bold"/>
                                    <TextBlock x:Name="txtTotalOrders" FontSize="20"/>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="5" Width="180">
                                <StackPanel>
                                    <TextBlock Text="Revenue" FontWeight="Bold"/>
                                    <TextBlock x:Name="txtRevenue" FontSize="20"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <TextBlock Text="Order Status Summary" FontSize="18" FontWeight="Bold" Margin="0,10,0,10"/>
                        <WrapPanel>
                            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="5" Width="180">
                                <StackPanel>
                                    <TextBlock Text="Pending" FontWeight="Bold"/>
                                    <TextBlock x:Name="txtPendingOrders" FontSize="18"/>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="5" Width="180">
                                <StackPanel>
                                    <TextBlock Text="Confirmed" FontWeight="Bold"/>
                                    <TextBlock x:Name="txtConfirmedOrders" FontSize="18"/>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="5" Width="180">
                                <StackPanel>
                                    <TextBlock Text="Cancelled" FontWeight="Bold"/>
                                    <TextBlock x:Name="txtCancelledOrders" FontSize="18"/>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="5" Width="180">
                                <StackPanel>
                                    <TextBlock Text="Completed" FontWeight="Bold"/>
                                    <TextBlock x:Name="txtCompletedOrders" FontSize="18"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Manage Products">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="txtSearchProduct" Width="250" Height="30" Margin="0,0,10,0"/>
                        <Button Content="Search" Width="100" Click="btnSearchProduct_Click" Margin="0,0,10,0"/>
                        <Button Content="Load All" Width="100" Click="btnLoadProducts_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="txtProductId" Width="60" Margin="0,0,10,0" IsReadOnly="True"/>
                        <TextBox x:Name="txtProductCode" Width="120" Margin="0,0,10,0"/>
                        <TextBox x:Name="txtProductName" Width="200" Margin="0,0,10,0"/>
                        <TextBox x:Name="txtBrand" Width="120" Margin="0,0,10,0"/>
                        <TextBox x:Name="txtBasePrice" Width="100" Margin="0,0,10,0"/>
                        <TextBox x:Name="txtImgUrl" Width="180" Margin="0,0,10,0"/>
                        <CheckBox x:Name="chkIsActive" Content="Active" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DataGrid x:Name="dgProducts"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          SelectionChanged="dgProducts_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding ProductId}" Width="50"/>
                                <DataGridTextColumn Header="Code" Binding="{Binding ProductCode}" Width="120"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding ProductName}" Width="200"/>
                                <DataGridTextColumn Header="Brand" Binding="{Binding Brand}" Width="120"/>
                                <DataGridTextColumn Header="Price" Binding="{Binding BasePrice}" Width="100"/>
                                <DataGridTextColumn Header="Image" Binding="{Binding ImgUrl}" Width="*"/>
                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Button Content="Add" Width="100" Margin="5" Click="btnAddProduct_Click"/>
                            <Button Content="Update" Width="100" Margin="5" Click="btnUpdateProduct_Click"/>
                            <Button Content="Delete" Width="100" Margin="5" Click="btnDeleteProduct_Click"/>
                            <Button Content="Clear" Width="100" Margin="5" Click="btnClearProductForm_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Manage Accounts">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DataGrid x:Name="dgUsers"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionChanged="dgUsers_SelectionChanged"
                              Margin="0,0,10,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding UserId}" Width="50"/>
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="120"/>
                            <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="150"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                            <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="100"/>
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="User Detail" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBox x:Name="txtUserId" Margin="0,0,0,10" IsReadOnly="True"/>
                        <TextBox x:Name="txtUsername" Margin="0,0,0,10" IsReadOnly="True"/>
                        <TextBox x:Name="txtFullName" Margin="0,0,0,10" IsReadOnly="True"/>
                        <TextBox x:Name="txtEmail" Margin="0,0,0,10" IsReadOnly="True"/>

                        <TextBlock Text="Roles" FontWeight="Bold" Margin="0,10,0,5"/>
                        <ListBox x:Name="lbRoles" Height="150" SelectionMode="Multiple" DisplayMemberPath="RoleName"/>

                        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                            <Button Content="Update Roles" Width="110" Margin="5" Click="btnUpdateRoles_Click"/>
                            <Button Content="Lock" Width="80" Margin="5" Click="btnLockUser_Click"/>
                            <Button Content="Unlock" Width="80" Margin="5" Click="btnUnlockUser_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>