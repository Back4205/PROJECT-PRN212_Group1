<Page x:Class="LaptopShop.WPF.Frames.WarehouseHomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="800"
      d:DesignWidth="1200"
      Title="Warehouse Manager"
      Background="White">

    <Page.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#64748b"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#6366f1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="50,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" Background="#6366f1" CornerRadius="6" Margin="0,0,8,0">
                        <Viewbox>
                            <Path Stroke="White" StrokeThickness="2" Data="M4,6 H20 V18 H4 Z M2,20 H22"/>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="LaptopShop" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Foreground="#1e293b"/>
                </StackPanel>

 

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{Binding FullName}" FontWeight="Bold" FontSize="13" Foreground="#1e293b"/>
                        <TextBlock Text="WAREHOUSE MANAGER" FontSize="9" Foreground="#94a3b8" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <Border Width="38" Height="38" CornerRadius="10" Background="#1e293b" Cursor="Hand" MouseLeftButtonUp="Avatar_MouseLeftButtonUp">
                        <Border.ContextMenu>
                            <ContextMenu x:Name="AvatarMenu">
                                <MenuItem Header="Đổi mật khẩu" Click="MenuUpdate_Click"/>
                                <Separator />
                                <MenuItem Header="Đăng xuất" Click="MenuLogout_Click"/>
                            </ContextMenu>
                        </Border.ContextMenu>
                        <TextBlock x:Name="txtAvatar" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Center" FontWeight="Bold" Text="WM" Margin="0,11,0,0"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="#F8FAFC">
            <StackPanel x:Name="SelectWarehousePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
                <TextBlock Text="CHỌN KHO QUẢN LÝ" FontSize="24" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="#1e293b"/>

                <TextBlock Text="Danh sách kho của bạn:" Margin="0,0,0,5" Foreground="#64748b"/>
                <ComboBox x:Name="cbWarehouses" Height="40" 
                          DisplayMemberPath="WarehouseName" 
                          SelectedValuePath="WarehouseId"
                          VerticalContentAlignment="Center"
                          Padding="10,0"/>

                <Button x:Name="btnSelectWarehouse" Content="Vào quản lý kho" 
                        Margin="0,20,0,0" Height="45" Background="#6366f1" 
                        Foreground="White" FontWeight="SemiBold"
                        Click="btnSelectWarehouse_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <TextBlock x:Name="txtStatus" Foreground="#ef4444" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <Frame x:Name="MainContentFrame" NavigationUIVisibility="Hidden" Visibility="Collapsed"/>
        </Grid>

        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0">
            <TextBlock Text="© 2026 LaptopShop - Hệ thống quản lý kho" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" 
                       Foreground="#94a3b8" FontSize="12"/>
        </Border>
    </Grid>
</Page>