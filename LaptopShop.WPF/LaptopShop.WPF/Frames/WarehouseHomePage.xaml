<Page x:Class="LaptopShop.WPF.Frames.WarehouseHomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Warehouse Manager">

    <Grid Background="#F4F4F4">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
            <TextBlock Text="CHỌN KHO QUẢN LÝ" FontSize="24" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Danh sách kho của bạn:" Margin="0,0,0,5"/>
            <ComboBox x:Name="cbWarehouses" Height="35" 
                      DisplayMemberPath="WarehouseName" 
                      SelectedValuePath="WarehouseId"/>

            <Button x:Name="btnSelectWarehouse" Content="Vào quản lý kho" 
                    Margin="0,20,0,0" Height="40" Background="#2196F3" 
                    Foreground="White" Click="btnSelectWarehouse_Click"/>

            <TextBlock x:Name="txtStatus" Foreground="Red" Margin="0,10,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>