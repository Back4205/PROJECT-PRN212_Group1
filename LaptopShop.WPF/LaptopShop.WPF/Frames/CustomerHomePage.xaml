<Page x:Class="LaptopShop.WPF.Frames.CustomerHomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="800"
      d:DesignWidth="1200"
      Title="CustomerHomePage"
      Background="White"
     >

    <Page.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#64748b"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#6366f1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="#F1F5F9"
                BorderThickness="0,0,0,1"
                Padding="50,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <Button x:Name="btnGoToCart"
                            Width="36"
                            Height="36"
                            Background="#F1F5F9"
                            Margin="0,0,12,0"
                            Cursor="Hand"
                            BorderThickness="0"
                            Click="btnGoToCart_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                    <Viewbox Width="18" Margin="9">
                                        <Path Fill="#64748b"
                                              Data="M7,18c-1.1,0-2,0.9-2,2s0.9,2,2,2s2-0.9,2-2S8.1,18,7,18z M1,2v2h2l3.6,7.59L5.25,15c-0.16,0.28-0.25,0.61-0.25,0.95 C5,17.08,5.92,18,7,18h12v-2H7.42 c-0.14,0-0.25-0.11-0.25-0.25 l0.03-0.12L8.1,14h7.45 c0.75,0,1.41-0.41,1.75-1.03 l3.58-6.49c0.08-0.14,0.12-0.31,0.12-0.48 c0-0.55-0.45-1-1-1H5.21 l-0.94-2H1z M17,18c-1.1,0-2,0.9-2,2 s0.9,2,2,2s2-0.9,2-2 S18.1,18,17,18z"/>
                                    </Viewbox>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Border Width="28"
                            Height="28"
                            Background="#6366f1"
                            CornerRadius="6"
                            Margin="0,0,8,0">
                        <Viewbox>
                            <Path Stroke="White"
                                  StrokeThickness="2"
                                  Data="M4,6 H20 V18 H4 Z M2,20 H22"/>
                        </Viewbox>
                    </Border>

                    <TextBlock Text="LaptopShop"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="#1e293b"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Button x:Name="NavHome"
                            Content="Home"
                            Style="{StaticResource NavButtonStyle}"
                            Click="NavHome_Click"/>
                    <Button x:Name="NavProduct"
                            Content="Product"
                            Style="{StaticResource NavButtonStyle}"
                            Click="NavProduct_Click"/>
                    <Button x:Name="NavOrder"
                            Content="Order History"
                            Style="{StaticResource NavButtonStyle}"
                            Click="NavOrder_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{Binding FullName}"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Foreground="#1e293b"/>
                        <TextBlock Text="CUSTOMER ACCOUNT"
                                   FontSize="9"
                                   Foreground="#94a3b8"/>
                    </StackPanel>
                    <Border Width="38"
        Height="38"
        CornerRadius="10"
        Background="Black"
        Cursor="Hand"
        MouseLeftButtonUp="Avatar_MouseLeftButtonUp">
                        <Border.ContextMenu>
                            <ContextMenu x:Name="AvatarMenu">
                                <MenuItem Header="Update Information" Click="MenuUpdate_Click">
                                    <MenuItem.Icon>
                                        <Path Data="M3,17.25V21h3.75L17.81,9.94l-3.75-3.75L3,17.25z" Fill="#64748b" Stretch="Uniform" Width="12"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Logout" Click="MenuLogout_Click">
                                    <MenuItem.Icon>
                                        <Path Data="M10,17l5-5-5-5v3H3v4h7V17z M21,3H11C9.9,3,9,3.9,9,5v4h2V5h10v14H11v-4H9v4c0,1.1,0.9,2,2,2h10c1.1,0,2-0.9,2-2V5C23,3.9,22.1,3,21,3z" Fill="#ef4444" Stretch="Uniform" Width="12"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Border.ContextMenu>

                        <TextBlock x:Name="txtAvatar"
               Foreground="White"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
            
        <Frame Grid.Row="1"
               x:Name="MainContentFrame"
               NavigationUIVisibility="Hidden"/>

        <Border Grid.Row="2"
                Background="#F8FAFC"
                BorderBrush="#F1F5F9"
                BorderThickness="0,1,0,0">
            <TextBlock Text="© 2026 LaptopShop - All Rights Reserved"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#94a3b8"
                       FontSize="12"/>
        </Border>
    </Grid>
</Page>