<UserControl x:Class="LaptopShop.WPF.Frames.AdminTabs.ProductManagementTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="txtSearchProduct" Width="250" Height="30" Margin="0,0,10,0"/>
            <Button Content="Search" Width="100" Margin="0,0,10,0" Click="btnSearchProduct_Click"/>
            <Button Content="Load All" Width="100" Click="btnLoadProducts_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="ID"/>
                <TextBox x:Name="txtProductId" Width="60" IsReadOnly="True"/>
            </StackPanel>

            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Code"/>
                <TextBox x:Name="txtProductCode" Width="120"/>
            </StackPanel>

            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Name"/>
                <TextBox x:Name="txtProductName" Width="200"/>
            </StackPanel>

            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Brand"/>
                <TextBox x:Name="txtBrand" Width="120"/>
            </StackPanel>

            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Price"/>
                <TextBox x:Name="txtBasePrice" Width="100"/>
            </StackPanel>

            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Image URL"/>
                <TextBox x:Name="txtImgUrl" Width="180"/>
            </StackPanel>

            <StackPanel VerticalAlignment="Bottom">
                <TextBlock Text="Status"/>
                <CheckBox x:Name="chkIsActive" Content="Active"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="dgProducts"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionChanged="dgProducts_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding ProductId}" Width="60"/>
                    <DataGridTextColumn Header="Code" Binding="{Binding ProductCode}" Width="120"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding ProductName}" Width="220"/>
                    <DataGridTextColumn Header="Brand" Binding="{Binding Brand}" Width="120"/>
                    <DataGridTextColumn Header="Price" Binding="{Binding BasePrice}" Width="120"/>
                    <DataGridTextColumn Header="Image" Binding="{Binding ImgUrl}" Width="*"/>
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,0">
                <Button Content="Add" Width="100" Margin="5" Click="btnAddProduct_Click"/>
                <Button Content="Update" Width="100" Margin="5" Click="btnUpdateProduct_Click"/>
                <Button Content="Delete" Width="100" Margin="5" Click="btnDeleteProduct_Click"/>
                <Button Content="Clear" Width="100" Margin="5" Click="btnClearProductForm_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>