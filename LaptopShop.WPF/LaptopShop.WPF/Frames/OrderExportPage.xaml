<Page x:Class="LaptopShop.WPF.Frames.OrderExportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LaptopShop.WPF.Frames"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="Quản Lý Xuất Kho">

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="20" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="← Quay lại" Click="btnBack_Click" Padding="10,5" Margin="0,0,20,0" Cursor="Hand"/>
                <TextBlock Text="DANH SÁCH ĐƠN HÀNG CHỜ XUẤT KHO (CONFIRMED)" 
                           FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Foreground="#2C3E50"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <DataGrid x:Name="dgOrders" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      SelectionMode="Single"
                      RowDetailsVisibilityMode="VisibleWhenSelected"
                      Background="White" 
                      BorderBrush="#DDD"
                      AlternatingRowBackground="#FAFAFA">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã Đơn" Binding="{Binding OrderId}" Width="80"/>
                    <DataGridTextColumn Header="Ngày Đặt" Binding="{Binding OrderDate, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" Width="150"/>
                    <DataGridTextColumn Header="Khách Hàng" Binding="{Binding Customer.User.FullName}" Width="*"/>
                    <DataGridTextColumn Header="Số Điện Thoại" Binding="{Binding Customer.User.Phone}" Width="150"/>
                    <DataGridTextColumn Header="Tổng Tiền" Binding="{Binding TotalAmount, StringFormat=\{0:N0\} VNĐ}" Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="DarkGreen"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>

                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <Border Background="#FFF9F1" BorderBrush="Orange" BorderThickness="2" Margin="10" Padding="15" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="📦 CHI TIẾT SẢN PHẨM CẦN XUẤT KHO" FontWeight="Bold" Foreground="DarkOrange" Margin="0,0,0,10"/>
                                <DataGrid ItemsSource="{Binding OrderItems}" 
                                          AutoGenerateColumns="False" 
                                          IsReadOnly="True" 
                                          Background="Transparent" 
                                          BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tên Sản Phẩm" Binding="{Binding SnapshotProductName}" Width="300"/>
                                        <DataGridTextColumn Header="Giá Niêm Yết" Binding="{Binding SnapshotPrice, StringFormat=\{0:N0\}}" Width="150"/>
                                        <DataGridTextColumn Header="Mã Thiết Bị (Serial ID)" 
                                                            Binding="{Binding ProductItemId, TargetNullValue='⚠️ CHƯA GÁN MÁY'}" 
                                                            Width="200">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ProductItemId}" Value="{x:Null}">
                                                            <Setter Property="Foreground" Value="Red"/>
                                                            <Setter Property="FontStyle" Value="Italic"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Button Content="XÁC NHẬN XUẤT KHO TOÀN BỘ ĐƠN HÀNG" 
                                        Click="btnConfirmExport_Click"
                                        HorizontalAlignment="Right" 
                                        Margin="0,15,0,0" 
                                        Background="DarkGreen" 
                                        Foreground="White" 
                                        Padding="15,8"
                                        FontWeight="Bold"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>
            </DataGrid>
        </Grid>
    </Grid>
</Page>