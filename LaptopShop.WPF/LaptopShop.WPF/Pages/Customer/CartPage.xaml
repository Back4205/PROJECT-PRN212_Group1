<Page x:Class="LaptopShop.WPF.Pages.Customer.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MyCart" Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="My Shopping Cart" FontSize="24" FontWeight="Bold" 
                   Foreground="#2C3E50" Margin="0,0,0,20"/>

        <DataGrid x:Name="dgCart" Grid.Row="1" AutoGenerateColumns="False" 
                  CanUserAddRows="False" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  Background="Transparent" BorderThickness="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Product Name" Binding="{Binding Product.ProductName}" Width="*"/>
                <DataGridTextColumn Header="Price" Binding="{Binding Product.BasePrice, StringFormat={}{0:N0} $}" Width="120"/>
                <DataGridTemplateColumn Header="Quantity" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                <Button Content="-" Width="25"
                        Click="BtnDecrease_Click"/>

                                <TextBlock Text="{Binding Quantity}"
                           Width="30"
                           TextAlignment="Center"
                           VerticalAlignment="Center"/>

                                <Button Content="+" Width="25"
                        Click="BtnIncrease_Click"/>

                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Action" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Delete" Background ="White"  Foreground ="Black"
                                    Padding="10,5" BorderThickness="0"
                                    Tag="{Binding CartItemId}" Click="btnRemove_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Vertical" HorizontalAlignment="Right" Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="Total Amount: " FontSize="18" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtTotalAmount" Text="0 $" FontSize="22" 
                           FontWeight="Bold" Foreground="#E67E22" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="Payment Method: Cash on Delivery (COD)" 
                       FontStyle="Italic" Foreground="#7F8C8D" 
                       HorizontalAlignment="Right" Margin="0,0,0,15"/>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnContinue" Content="Continue Shopping" Background="#95A5A6" Foreground="White" 
                        Width="150" Height="40" Margin="0,0,10,0" BorderThickness="0" Click="btnContinue_Click"/>

                <Button Content="ORDER NOW" x:Name="btnPlaceOrder" Click="btnPlaceOrder_Click"
                        Background="#27AE60" Foreground="White" FontWeight="Bold"
                        Width="200" Height="40" BorderThickness="0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>