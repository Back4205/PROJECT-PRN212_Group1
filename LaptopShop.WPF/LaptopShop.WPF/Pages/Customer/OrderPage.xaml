<Page x:Class="LaptopShop.WPF.Pages.Customer.OrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       Background="White"
      Title="OrderPage">

    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock Text="My Orders" FontSize="26" FontWeight="Bold" Margin="0,0,0,20"/>

            <ItemsControl x:Name="icOrders">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,30" Padding="15" CornerRadius="5">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding OrderId, StringFormat='Order ID: {0}'}" FontSize="16" FontWeight="Bold" DockPanel.Dock="Left"/>
                                    <TextBlock Text="{Binding OrderDate, StringFormat='Date: {0:dd/MM/yyyy HH:mm}'}"
                   FontSize="14"
                   Foreground="Gray" Margin="20,2,0,10"></TextBlock>
                                    <TextBlock Text="{Binding Status}" Foreground="Orange" FontWeight="Bold" DockPanel.Dock="Right"/>
                                </DockPanel>

                                <DataGrid ItemsSource="{Binding OrderItems}" 
                                          AutoGenerateColumns="False" 
                                          IsReadOnly="True" 
                                          Background="White"
                                          GridLinesVisibility="Horizontal">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Product Name" Binding="{Binding SnapshotProductName}" Width="*"/>
                                        <DataGridTextColumn Header="Price" Binding="{Binding SnapshotPrice}" Width="300"/>
                                        <DataGridTextColumn Header="SerialNumber" Binding="{Binding ProductItem.SerialNumber}" Width="250"/>
                                        
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <TextBlock Text="Grand Total: " VerticalAlignment="Center"/>

                                    <TextBlock Text="{Binding TotalAmountOrder, StringFormat={}{0:N0} VNĐ}" 
               FontSize="22" 
               FontWeight="Bold" 
               Foreground="#E67E22" 
               VerticalAlignment="Center"/>
                                </StackPanel>

                                <Button Content="Cancel Order"
                                        Click="BtnCancelOrder_Click"
                                        Background="Red" Foreground="White"
                                        Width="120" Height="30"
                                        HorizontalAlignment="Right" Margin="0,15,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>