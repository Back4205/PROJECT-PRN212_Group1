<Page x:Class="LaptopShop.WPF.Pages.Staff.OrderList"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LaptopShop.WPF.Pages.Staff"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="Quản lý đơn hàng" Background="#F8FAFC">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="ĐƠN HÀNG" FontSize="20" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>

            <Border Background="White" CornerRadius="5" BorderBrush="#E2E8F0" BorderThickness="1" Margin="30,0,10,0" Padding="5,2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔍" VerticalAlignment="Center" Margin="5,0"/>
                    <TextBox x:Name="txtSearchName" Width="200" BorderThickness="0" VerticalAlignment="Center" 
                             GotFocus="txtSearchName_GotFocus" LostFocus="txtSearchName_LostFocus"
                             TextChanged="Filter_Changed" Foreground="Gray" Text="Nhập tên khách hàng..."/>
                </StackPanel>
            </Border>

            <TextBlock Text="Trạng thái:" VerticalAlignment="Center" Margin="10,0,5,0" Foreground="#64748B"/>
            <ComboBox x:Name="cbStatusFilter" Width="130" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Tất cả" IsSelected="True"/>
                <ComboBoxItem Content="Pending"/>
                <ComboBoxItem Content="Confirmed"/>
                <ComboBoxItem Content="Cancelled"/>
                <ComboBoxItem Content="Completed"/>
            </ComboBox>

            <Button Content="Làm mới" Margin="20,0,0,0" Padding="15,5" Background="#6366F1" Foreground="White" 
                    BorderThickness="0" Click="btnRefresh_Click" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>

        <DataGrid x:Name="dgOrders" Grid.Row="1" AutoGenerateColumns="False" 
                  CanUserAddRows="False" IsReadOnly="True"
                  SelectionChanged="dgOrders_SelectionChanged"
                  Background="White" BorderThickness="1" BorderBrush="#E2E8F0"
                  RowHeight="40" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã ĐH" Binding="{Binding OrderId}" Width="60"/>
                <DataGridTextColumn Header="Khách hàng" Binding="{Binding Customer.User.FullName}" Width="*"/>
                <DataGridTextColumn Header="Ngày đặt" Binding="{Binding OrderDate, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="150"/>
                <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TotalAmount, StringFormat={}{0:N0} VNĐ}" Width="120"/>

                <DataGridTemplateColumn Header="Trạng thái" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12" Padding="10,3" HorizontalAlignment="Center" Background="#F1F5F9">
                                <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="11" Foreground="#475569"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Thao tác" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Xác nhận" Background="#10B981" Foreground="White" 
                                        Padding="10,2" Margin="2" BorderThickness="0" Click="btnConfirm_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>

                                <Button Content="Hủy" Background="#EF4444" Foreground="White" 
                                        Padding="10,2" Margin="2" BorderThickness="0" Click="btnCancel_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Separator Grid.Row="2" Margin="0,15" Background="#E2E8F0"/>

        <GroupBox Grid.Row="3" Header="CHI TIẾT SẢN PHẨM TRONG ĐƠN HÀNG" BorderThickness="1" BorderBrush="#E2E8F0" Padding="5">
            <GroupBox.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontWeight="Bold" Foreground="#64748B" FontSize="12"/>
                </DataTemplate>
            </GroupBox.HeaderTemplate>
            <DataGrid x:Name="dgOrderItems" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      Background="Transparent" BorderThickness="0" RowHeight="35">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding SnapshotProductName}" Width="*"/>
                    <DataGridTextColumn Header="Giá lúc mua" Binding="{Binding SnapshotPrice, StringFormat={}{0:N0} VNĐ}" Width="150"/>
                    <DataGridTextColumn Header="Số Serial" Binding="{Binding ProductItem.SerialNumber}" Width="180">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#6366F1"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</Page>