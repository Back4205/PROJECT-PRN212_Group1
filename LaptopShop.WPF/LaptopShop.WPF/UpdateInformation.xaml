<Window x:Class="LaptopShop.WPF.UpdateInformation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LaptopShop.WPF"
        mc:Ignorable="d"
        Title="UpdateInformation" WindowState="Maximized">
    <Grid Background="#F0F2F5" Margin="0,0,-183,-147">
        <Border Background="White" CornerRadius="12" Padding="25" Margin="20" VerticalAlignment="Top">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="1"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="THÔNG TIN TÀI KHOẢN" FontSize="20" FontWeight="Bold" 
                           Foreground="#1A73E8" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Họ và tên" Margin="0,0,0,5" FontWeight="SemiBold"/>
                <TextBox x:Name="txtFullName" Padding="8" Margin="0,0,0,12"/>

                <TextBlock Text="Email" Margin="0,0,0,5" FontWeight="SemiBold"/>
                <TextBox x:Name="txtEmail" Padding="8" Margin="0,0,0,12"/>

                <TextBlock Text="Số điện thoại" Margin="0,0,0,5" FontWeight="SemiBold"/>
                <TextBox x:Name="txtPhone" Padding="8" Margin="0,0,0,12"/>

                <StackPanel x:Name="spCustomerAddress" Visibility="Collapsed">
                    <Separator Margin="0,5,0,15"/>
                    <TextBlock Text="Địa chỉ nhận hàng (Dành cho khách hàng)" 
                               Margin="0,0,0,5" FontWeight="SemiBold" Foreground="#27AE60"/>
                    <TextBox x:Name="txtAddress" Padding="8" Margin="0,0,0,12" 
                             Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                             BorderBrush="#27AE60"/>
                </StackPanel>

                <Separator Margin="0,5,0,15"/>

                <TextBlock Text="Mật khẩu mới (Bỏ trống nếu không đổi)" Margin="0,0,0,5" Foreground="#7F8C8D"/>
                <PasswordBox x:Name="txtNewPassword" Padding="8" Margin="0,0,0,12"/>

                <TextBlock Text="Xác nhận mật khẩu" Margin="0,0,0,5" Foreground="#7F8C8D"/>
                <PasswordBox x:Name="txtConfirmPassword" Padding="8" Margin="0,0,0,20"/>

                <UniformGrid Columns="2">
                    <Button x:Name="btnUpdate" Content="CẬP NHẬT" Click="btnUpdate_Click" 
                            Height="40" Margin="0,0,5,0" Background="#1A73E8" Foreground="White" 
                            FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>

                    <Button x:Name="btnCancel" Content="HỦY" Click="btnCancel_Click" 
                            Height="40" Margin="5,0,0,0" Background="#EA4335" Foreground="White" 
                            FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                </UniformGrid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
